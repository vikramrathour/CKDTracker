# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain. Default: <project-id>.firebaseapp.com. For production (and the
# Android TWA) set it to the app's own domain, e.g. ckd.example.com:
# next.config.js proxies /__/auth/* and /__/firebase/* to
# <project-id>.firebaseapp.com, so Google redirect sign-in stays first-party
# under browser storage partitioning. When you switch it, also add
# https://<your-domain>/__/auth/handler to the OAuth client's authorized
# redirect URIs (Google Cloud console -> APIs & Services -> Credentials) and the
# domain to Firebase Auth -> Settings -> Authorized domains.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Cloud Messaging (FCM) VAPID Key
# Get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Gemini API key: powers chat (/api/chat) and AI document extraction
# (/api/documents/extract, and the legacy /api/pdf/parse fallback).
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model for chat and extraction (default: gemini-2.5-flash).
# The key MUST belong to a billing-enabled (paid) project: free-tier Gemini API
# traffic may be used by Google for training, which is not OK for medical data.
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin service account (server-only, never NEXT_PUBLIC_).
# REQUIRED in production: invites, chat, document extraction, export, the
# visit-prep PDF, push notifications, /api/cron/reminders and account deletion
# all use Admin Firestore/Storage/Messaging. Also used by scripts/*.ts.
# Not needed with local emulators (NEXT_PUBLIC_USE_EMULATORS=1): Admin then
# runs with just NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Value: base64 of the service-account JSON, e.g. `base64 -w0 service-account.json`
FIREBASE_SERVICE_ACCOUNT_B64=

# Set to '1' to show a "Load demo data" button that loads synthetic records.
NEXT_PUBLIC_ENABLE_DEMO=

# Vercel Cron Secret (for securing cron endpoints)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# Local emulators (npx firebase-tools emulators:start). Firebase Admin picks up
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST / FIREBASE_STORAGE_EMULATOR_HOST automatically.
NEXT_PUBLIC_USE_EMULATORS=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Chat with your reports (/api/chat). Uses GEMINI_API_KEY + GEMINI_MODEL above,
# which MUST be on a billing-enabled (paid) project for medical data.
# Per-user caps (server-only usage/{uid}_YYYYMMDD and usage/{uid}_YYYYMM, India time):
CHAT_DAILY_LIMIT=50
CHAT_MONTHLY_TOKENS=2000000
# Optional: Storage bucket for get_document (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET)
# FIREBASE_STORAGE_BUCKET=

# ---- Phase 7: push, offline, Play Store ----
# Push notifications also need NEXT_PUBLIC_FIREBASE_VAPID_KEY (above): Firebase
# console -> Project settings -> Cloud Messaging -> Web Push certificates ->
# Generate key pair; paste the PUBLIC key. Server sending uses
# FIREBASE_SERVICE_ACCOUNT_B64. CRON_SECRET (above) protects
# /api/cron/reminders; Vercel Cron sends it automatically as a Bearer token.

# Public origin of the deployment (metadata, docs), e.g. https://ckd.example.com
NEXT_PUBLIC_APP_URL=
# Contact address shown on /privacy and /terms
NEXT_PUBLIC_SUPPORT_EMAIL=

# Android TWA: served at /.well-known/assetlinks.json (twa/README.md).
# Fingerprints: comma-separated SHA-256 (upload key AND Play app-signing key).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=

# Optional Firebase App Check (reCAPTCHA Enterprise site key). Unset = off.
# Enforcement is a separate switch in the Firebase console (README).
NEXT_PUBLIC_APPCHECK_SITE_KEY=
# '1' locally: App Check prints a debug token in the console to register.
# NEXT_PUBLIC_APPCHECK_DEBUG=

# Service worker is disabled in `next dev`; '1' enables it (needed to test push locally).
# NEXT_PUBLIC_ENABLE_SW_IN_DEV=

# Max AI report extractions per user per day (regex-only parses are free)
EXTRACT_DAILY_LIMIT=30
