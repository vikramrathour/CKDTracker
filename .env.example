# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
# Auth domain. Default: <project-id>.firebaseapp.com. For production (and the
# Android TWA) set it to the app's own domain, e.g. ckd.example.com:
# next.config.js proxies /__/auth/* and /__/firebase/* to
# <project-id>.firebaseapp.com, so Google redirect sign-in stays first-party
# under browser storage partitioning. When you switch it, also add
# https://<your-domain>/__/auth/handler to the OAuth client's authorized
# redirect URIs (Google Cloud console -> APIs & Services -> Credentials) and the
# domain to Firebase Auth -> Settings -> Authorized domains.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Cloud Messaging (FCM) VAPID Key
# Get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Gemini API Key (for PDF parsing fallback)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for the fallback (default: gemini-2.5-flash).
# The key MUST belong to a billing-enabled (paid) project: free-tier Gemini API
# traffic may be used by Google for training, which is not OK for medical data.
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin service account (server-only, never NEXT_PUBLIC_).
# Optional in Phase 0: ID-token verification only needs NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Needed later for Admin Firestore access and for scripts/seed-owner.ts.
# Value: base64 of the service-account JSON, e.g. `base64 -w0 service-account.json`
FIREBASE_SERVICE_ACCOUNT_B64=

# Set to '1' to show a "Load demo data" button that loads synthetic records.
NEXT_PUBLIC_ENABLE_DEMO=

# Vercel Cron Secret (for securing cron endpoints)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# Local emulators (npx firebase-tools emulators:start). Firebase Admin picks up
# FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST / FIREBASE_STORAGE_EMULATOR_HOST automatically.
NEXT_PUBLIC_USE_EMULATORS=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
