# Firebase Configuration
# Get these from Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Cloud Messaging (FCM) VAPID Key
# Get from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Google Gemini API Key (for PDF parsing fallback)
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for the fallback (default: gemini-2.5-flash).
# The key MUST belong to a billing-enabled (paid) project: free-tier Gemini API
# traffic may be used by Google for training, which is not OK for medical data.
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin service account (server-only, never NEXT_PUBLIC_).
# Optional in Phase 0: ID-token verification only needs NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Needed later for Admin Firestore access and for scripts/seed-owner.ts.
# Value: base64 of the service-account JSON, e.g. `base64 -w0 service-account.json`
FIREBASE_SERVICE_ACCOUNT_B64=

# Set to '1' to show a "Load demo data" button that loads synthetic records.
NEXT_PUBLIC_ENABLE_DEMO=

# Vercel Cron Secret (for securing cron endpoints)
# Generate a random string: openssl rand -hex 32
CRON_SECRET=
