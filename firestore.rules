rules_version = '2';

// CKD Tracker — multi-tenant care-circle model (Phase 2).
//
//   users/{uid}                         profile + activePatientId (owner-only)
//   users/{uid}/fcmTokens/{token}       push tokens (owner-only)
//   users/{uid}/labRecords|medications  LEGACY, read-only until the cleanup release
//   patients/{pid}                      ownerUid, displayName, dob, transplantDate, doctor, hospital, nextLabDate
//     members/{uid}                     uid, role (owner|editor|viewer), displayName, phone (masked), addedBy
//     labRecords | medications(/doseHistory) | visits | vitals | documents
//       | questions | targets/{testName} | alertRules        viewer read, editor write
//     activity/{id}                     append-only audit
//     chats/{chatId}/messages/{mid}     server-written; readable only by the thread creator
//   invites/{id}, usage/{id}, sharedLinks/{id}                server-only
//
// Tests: tests/rules/*.test.ts (`npm run test:rules`).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function patientPath(pid) {
      return /databases/$(database)/documents/patients/$(pid);
    }

    function myMemberPath(pid) {
      return /databases/$(database)/documents/patients/$(pid)/members/$(request.auth.uid);
    }

    function rank(role) {
      return {'viewer': 1, 'editor': 2, 'owner': 3}.get(role, 0);
    }

    // The caller's role on pid is at least `min`. exists()+get() on the same
    // path count as one billed read and are cached for the whole request.
    function hasRole(pid, min) {
      return signedIn()
        && exists(myMemberPath(pid))
        && rank(get(myMemberPath(pid)).data.role) >= rank(min);
    }

    // pid naming: your own profile is pid == uid; people you care for are
    // `${uid}_${suffix}`. Stops anyone claiming another user's pid (squatting).
    function isPidForCaller(pid) {
      return pid == request.auth.uid || pid.matches(request.auth.uid + '_[A-Za-z0-9]{6,40}');
    }

    function optString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    function patientEditable() {
      return ['displayName', 'relationship', 'dateOfBirth', 'transplantDate', 'doctorName', 'hospital',
              'nextLabDate', 'updatedAt'];
    }

    function validPatientFields(data) {
      return data.displayName is string
        && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('relationship' in data) || data.relationship in ['self', 'family', 'other'])
        && optString(data, 'dateOfBirth', 10)
        && optString(data, 'transplantDate', 10)
        && optString(data, 'doctorName', 120)
        && optString(data, 'hospital', 160)
        && optDate(data, 'nextLabDate');
    }

    // Data docs: createdBy is set to the author on create and never changes.
    function createdByMe() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function createdByUnchanged() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    function isDataCollection(coll) {
      return coll in ['labRecords', 'medications', 'visits', 'vitals', 'documents',
                      'questions', 'targets', 'alertRules'];
    }

    // ------------------------------------------------ clinical data shapes
    //
    // Checked on the full post-write document (create and update), so a client
    // can never store a field with a type that breaks other members' views,
    // exports or the visit-prep PDF. Field names/limits mirror the writers in
    // lib/firebase/*.ts. Extra fields are allowed (legacy/migrated docs).

    function ymd() {
      return '^[0-9]{4}-[0-9]{2}-[0-9]{2}$';
    }

    function optNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function optBool(data, key) {
      return !(key in data) || data[key] is bool;
    }

    function optList(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is list && data[key].size() <= max);
    }

    function optDate(data, key) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].matches(ymd()));
    }

    function optTimestamp(data, key) {
      return !(key in data) || data[key] == null || data[key] is timestamp;
    }

    // patients/{pid}/labRecords  (lib/firebase/firestore.ts, documents.ts)
    function validLabRecord(d) {
      return d.recordDate is timestamp
        && d.values is list && d.values.size() <= 200
        && optString(d, 'labName', 120)
        && optString(d, 'doctorName', 120)
        && optString(d, 'notes', 5000)
        && optString(d, 'pdfPath', 600)
        && optString(d, 'sourceDocumentId', 128);
    }

    // patients/{pid}/visits  (lib/firebase/visits.ts, components/visits/visit-form.tsx)
    function validVisit(d) {
      return d.visitDate is string && d.visitDate.matches(ymd())
        && optDate(d, 'nextVisitDate')
        && (!('visitTime' in d) || d.visitTime == null
            || (d.visitTime is string && d.visitTime.matches('^([0-9]{2}:[0-9]{2})?$')))
        && optString(d, 'doctorName', 120)
        && optString(d, 'hospital', 160)
        && optString(d, 'purpose', 300)
        && optString(d, 'notes', 4000)
        && optString(d, 'advice', 4000)
        && optString(d, 'doseChanges', 2000)
        && optList(d, 'linkedRecordIds', 200)
        && optList(d, 'questionIds', 200)
        && optList(d, 'doseChangeRefs', 200);
    }

    // patients/{pid}/questions  (lib/firebase/questions.ts, chat.ts)
    function validQuestion(d) {
      return d.text is string && d.text.size() <= 1000
        && d.status in ['open', 'asked', 'answered']
        && optString(d, 'answer', 4000)
        && optString(d, 'visitId', 128)
        && (!('source' in d) || d.source in ['user', 'chat'])
        && optTimestamp(d, 'askedAt')
        && optTimestamp(d, 'answeredAt');
    }

    // patients/{pid}/vitals  (lib/firebase/vitals.ts)
    function validVital(d) {
      return d.recordedAt is timestamp
        && optNumber(d, 'systolic')
        && optNumber(d, 'diastolic')
        && optNumber(d, 'pulse')
        && optNumber(d, 'weightKg')
        && optNumber(d, 'temperatureC')
        && optNumber(d, 'glucose')
        && optNumber(d, 'urineOutputMl')
        && optString(d, 'notes', 500);
    }

    // patients/{pid}/targets/{testName}  (lib/firebase/patients.ts setTarget)
    function validTarget(d, docId) {
      return d.testName == docId
        && optNumber(d, 'min')
        && optNumber(d, 'max')
        && optString(d, 'unit', 30)
        && optString(d, 'setBy', 120)
        && optString(d, 'notes', 500);
    }

    // patients/{pid}/alertRules  (lib/firebase/alert-rules.ts; ops from lib/calculations/alerts.ts)
    // above/below need a threshold; change-pct a positive percent; outside-target none.
    function validAlertRule(d) {
      return d.testName is string && d.testName.size() > 0 && d.testName.size() <= 100
        && d.op in ['above', 'below', 'change-pct', 'outside-target']
        && optNumber(d, 'threshold')
        && (d.op == 'outside-target'
            || (d.threshold is number && (d.op != 'change-pct' || (d.threshold > 0 && d.threshold <= 1000))))
        && d.enabled is bool
        && optString(d, 'label', 80);
    }

    // patients/{pid}/medications  (lib/firebase/medications.ts; lenient for migrated docs)
    function validMedication(d) {
      return d.name is string && d.name.size() <= 200
        && optString(d, 'dose', 200)
        && optString(d, 'frequency', 200)
        && optString(d, 'category', 60)
        && optString(d, 'prescribedBy', 200)
        && optString(d, 'notes', 2000)
        && optString(d, 'startDate', 40)
        && optString(d, 'stoppedAt', 40)
        && optString(d, 'stopReason', 300)
        && optBool(d, 'isActive')
        && optList(d, 'timeOfDay', 12);
    }

    function documentContentTypes() {
      return ['application/pdf', 'image/jpeg', 'image/png', 'image/webp', 'image/heic'];
    }

    // patients/{pid}/documents/{docId}  (lib/firebase/storage.ts uploadDocument)
    // storagePath must be this document's own folder: storage.rules only accept
    // an upload at exactly that path, and server routes only read from it.
    // `extraction` is the server's cache (Admin SDK) and never client-written.
    function validDocument(pid, docId, d) {
      return d.kind in ['lab-report', 'prescription', 'discharge-summary', 'imaging', 'other']
        && d.fileName is string && d.fileName.size() > 0 && d.fileName.size() <= 200
        && !d.fileName.matches('.*[/\\\\].*') && !(d.fileName in ['.', '..'])
        && d.storagePath == 'patients/' + pid + '/documents/' + docId + '/' + d.fileName
        && d.contentType in documentContentTypes()
        && d.size is int && d.size >= 0 && d.size < 20 * 1024 * 1024
        && (!('source' in d) || d.source in ['upload', 'camera'])
        && validDocumentEdits(d);
    }

    // The fields a client may change after upload (also checked on create).
    function validDocumentEdits(d) {
      return d.kind in ['lab-report', 'prescription', 'discharge-summary', 'imaging', 'other']
        && optString(d, 'title', 200)
        && optDate(d, 'documentDate')
        && optString(d, 'labRecordId', 128);
    }

    function validData(pid, coll, docId, d) {
      return coll == 'labRecords' ? validLabRecord(d)
        : coll == 'visits' ? validVisit(d)
        : coll == 'questions' ? validQuestion(d)
        : coll == 'vitals' ? validVital(d)
        : coll == 'targets' ? validTarget(d, docId)
        : coll == 'alertRules' ? validAlertRule(d)
        : coll == 'medications' ? validMedication(d)
        : coll == 'documents' ? validDocument(pid, docId, d)
        : true;
    }

    // Only kind/title/documentDate/labRecordId change after upload; the file
    // identity and the server's extraction cache are fixed (so migrated docs,
    // whose file fields predate these rules, stay editable).
    function documentUpdateAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['storagePath', 'fileName', 'contentType', 'size', 'extraction', 'source', 'legacyPath']);
    }

    // ------------------------------------------------------------ activity
    //
    // Client-written audit entries. member.added / member.invited /
    // invite.revoked / member.left are written by the server (Admin SDK) only.
    // member.role-changed / member.removed accompany owner-only member edits.

    function clientActivityActions() {
      return ['patient.created', 'patient.updated',
              'record.added', 'record.updated', 'record.deleted',
              'medication.added', 'medication.updated', 'medication.deleted', 'medication.stopped',
              'document.uploaded', 'visit.added', 'question.added',
              'target.updated', 'target.removed', 'vital.added'];
    }

    function validActivity(pid, d) {
      return d.keys().hasOnly(['actorUid', 'actorName', 'action', 'targetType', 'targetId', 'summary', 'createdAt'])
        && d.actorUid == request.auth.uid
        && d.createdAt == request.time
        && (d.action in clientActivityActions()
            || (d.action in ['member.role-changed', 'member.removed'] && hasRole(pid, 'owner')))
        // The name shown in the feed is the one the care circle knows you by.
        && (!('actorName' in d) || d.actorName == get(myMemberPath(pid)).data.get('displayName', null))
        && optString(d, 'targetType', 40)
        && optString(d, 'targetId', 200)
        && optString(d, 'summary', 200);
    }

    // Member docs never hold a full phone number (every viewer can read them):
    // only a masked one like '+91 ••••• •••01' (lib/phone.ts maskPhone).
    function maskedPhoneOrNull(d) {
      return !('phone' in d) || d.phone == null
        || (d.phone is string && d.phone.size() <= 32 && d.phone.matches('.*•.*')
            && !d.phone.matches('.*[0-9]{5}.*'));
    }

    // ------------------------------------------------------------------ users

    match /users/{uid} {
      // Profile doc (fullName, email, phoneNumber, activePatientId, migratedAt, …)
      allow read, write: if isSelf(uid);

      match /fcmTokens/{token} {
        allow read, write: if isSelf(uid);
      }

      // LEGACY single-tenant data, migrated to patients/{uid}/… by
      // scripts/migrate-to-patients.ts. Kept readable for one release, then
      // removed by a cleanup script. No client writes.
      match /labRecords/{id} {
        allow read: if isSelf(uid);
      }
      match /medications/{id} {
        allow read: if isSelf(uid);
      }
    }

    // ------------------------------------------- memberships (collection group)

    // listMyPatients(): collectionGroup('members').where('uid', '==', me).
    // A query is allowed only if every result is the caller's own membership.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --------------------------------------------------------------- patients

    match /patients/{pid} {
      allow get: if hasRole(pid, 'viewer');
      allow list: if false;

      // Created in ONE batch with the owner's member doc (see members create).
      allow create: if signedIn()
        && isPidForCaller(pid)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(patientEditable().concat(['ownerUid', 'createdAt']))
        && validPatientFields(request.resource.data)
        && getAfter(myMemberPath(pid)).data.role == 'owner';

      // Editors can keep doctor/hospital/dates current; ownerUid/createdAt are fixed.
      allow update: if hasRole(pid, 'editor')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(patientEditable())
        && validPatientFields(request.resource.data);

      // Deleting a patient (and its subcollections) is a server-side operation.
      allow delete: if false;

      // ---- care circle
      match /members/{memberUid} {
        allow read: if hasRole(pid, 'viewer');

        // Owner bootstrap only: the patient doc must not exist yet and must be
        // created in the same batch with ownerUid == caller. Every other member
        // is added by the server (invite redemption, Admin SDK).
        allow create: if isSelf(memberUid)
          && request.resource.data.uid == memberUid
          && request.resource.data.role == 'owner'
          && request.resource.data.addedBy == memberUid
          && request.resource.data.keys().hasOnly(['uid', 'role', 'displayName', 'phone', 'addedBy', 'addedAt'])
          && maskedPhoneOrNull(request.resource.data)
          && !exists(patientPath(pid))
          && getAfter(patientPath(pid)).data.ownerUid == request.auth.uid;

        // Only the owner changes roles, only between editor and viewer, and
        // never on the owner's own doc.
        allow update: if hasRole(pid, 'owner')
          && resource.data.role != 'owner'
          && request.resource.data.role in ['editor', 'viewer']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']);

        // A member can leave; the owner can remove others; the owner doc stays.
        allow delete: if resource.data.role != 'owner'
          && (isSelf(memberUid) || hasRole(pid, 'owner'));
      }

      // ---- clinical data: viewers read, editors write
      match /{coll}/{docId} {
        allow read: if isDataCollection(coll) && hasRole(pid, 'viewer');
        allow create: if isDataCollection(coll) && hasRole(pid, 'editor') && createdByMe()
          && validData(pid, coll, docId, request.resource.data)
          && !(coll == 'documents' && 'extraction' in request.resource.data);
        allow update: if isDataCollection(coll) && hasRole(pid, 'editor') && createdByUnchanged()
          && (coll == 'documents'
                ? documentUpdateAllowed() && validDocumentEdits(request.resource.data)
                : validData(pid, coll, docId, request.resource.data));
        allow delete: if isDataCollection(coll) && hasRole(pid, 'editor');
      }

      match /medications/{medId}/doseHistory/{doseId} {
        allow read: if hasRole(pid, 'viewer');
        allow create: if hasRole(pid, 'editor') && createdByMe();
        allow update: if hasRole(pid, 'editor') && createdByUnchanged();
        allow delete: if hasRole(pid, 'editor');
      }

      // ---- audit trail: append-only
      match /activity/{entryId} {
        allow read: if hasRole(pid, 'viewer');
        allow create: if hasRole(pid, 'editor') && validActivity(pid, request.resource.data);
        allow update, delete: if false;
      }

      // ---- AI chat: written by /api/chat (Admin SDK); private to the thread creator
      match /chats/{chatId} {
        allow read: if hasRole(pid, 'viewer') && resource.data.createdBy == request.auth.uid;
        allow write: if false;

        match /messages/{messageId} {
          allow read: if hasRole(pid, 'viewer')
            && get(/databases/$(database)/documents/patients/$(pid)/chats/$(chatId)).data.createdBy == request.auth.uid;
          allow write: if false;
        }
      }
    }

    // ------------------------------------------------------------ server-only

    // Invites are created/redeemed through /api/invites (Admin SDK).
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // Per-user chat usage caps, maintained by /api/chat.
    match /usage/{usageId} {
      allow read, write: if false;
    }

    // sharedLinks: closed (legacy; nothing reads it). A shared view, if ever
    // added, must be served from a server route, never a client token scan.
    match /sharedLinks/{linkId} {
      allow read, write: if false;
    }
  }
}
